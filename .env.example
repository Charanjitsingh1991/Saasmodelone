# Local development only. Copy to .env (ignored) and change the role passwords.
# The harness refuses any PostgreSQL host other than localhost/127.0.0.1/[::1]
# or a Unix socket.
DB_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
DB_OWNER_URL=postgres://saas_owner:local-owner-password@localhost:54329/saasmodels
DB_RUNTIME_URL=postgres://saas_runtime:local-runtime-password@localhost:54329/saasmodels

SAAS_OWNER_PASSWORD=local-owner-password
SAAS_RUNTIME_PASSWORD=local-runtime-password

# Test-only superuser URL. The harness creates and drops disposable databases.
TEST_DB_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
TEST_DB_OWNER_URL=postgres://saas_owner:local-owner-password@localhost:54329/saasmodels
TEST_DB_RUNTIME_URL=postgres://saas_runtime:local-runtime-password@localhost:54329/saasmodels
